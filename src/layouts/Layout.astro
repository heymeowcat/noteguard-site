---
import "../styles/global.css";
import { site, url, home } from "../lib/site";

interface Props {
	title?: string;
	description?: string;
	structuredData?: object | object[];
	/** Hide the site navigation on pages that provide their own. */
	hideNav?: boolean;
	ogImageAlt?: string;
	/** Set on pages that are part of the site but not the entry point. */
	breadcrumbs?: { name: string; path: string }[];
	/** Overrides the robots directive, for pages that should not be indexed. */
	robots?: string;
	/** Overrides the canonical URL, for pages that stand in for another. */
	canonical?: string;
}

const {
	title = "NoteGuard — Private, offline notes with on-device AI",
	description = "A private Android notes app. Your notes are plain Markdown files in a folder you own, locked notes are encrypted with your PIN, and the AI runs on your device.",
	structuredData,
	hideNav = false,
	ogImageAlt = "NoteGuard — private, offline notes for Android",
	breadcrumbs = [],
	robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
	canonical,
} = Astro.props;

const SITE_URL = Astro.site?.toString().replace(/\/$/, "") ?? "";

/* The sitemap lists every page with a trailing slash, so the canonical
   URLs match it rather than pointing at a redirect. */
const canonicalURL = canonical
	? new URL(canonical, Astro.site)
	: new URL(Astro.url.pathname.replace(/\/+$/, "") + "/", Astro.site);
const ogImageURL = new URL(url("/og-image.jpg"), Astro.site);
const isHome = Astro.url.pathname.replace(/\/$/, "") === url("").replace(/\/$/, "");

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"@id": `${SITE_URL}${url("/")}#website`,
		url: `${SITE_URL}${url("/")}`,
		name: site.name,
		inLanguage: "en-US",
		publisher: { "@id": `${SITE_URL}${url("/")}#publisher` },
	},
	{
		"@context": "https://schema.org",
		"@type": "Organization",
		"@id": `${SITE_URL}${url("/")}#publisher`,
		name: site.name,
		url: `${SITE_URL}${url("/")}`,
		sameAs: ["https://github.com/heymeowcat"],
	},
	...(structuredData
		? Array.isArray(structuredData)
			? structuredData
			: [structuredData]
		: []),
	...(breadcrumbs.length
		? [
				{
					"@context": "https://schema.org",
					"@type": "BreadcrumbList",
					itemListElement: [
						{
							"@type": "ListItem",
							position: 1,
							name: "Home",
							item: `${SITE_URL}${url("/")}`,
						},
						...breadcrumbs.map((crumb, index) => ({
							"@type": "ListItem",
							position: index + 2,
							name: crumb.name,
							item: `${SITE_URL}${url(crumb.path)}`,
						})),
					],
				},
			]
		: []),
];
---

<!doctype html>
<html lang="en-US" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="author" content={site.author} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" type="application/xml" href={url("/sitemap.xml")} />

		<!--
			Any asset or link that somehow arrives over plain http is upgraded
			to https before it is used.
		-->
		<meta
			http-equiv="Content-Security-Policy"
			content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
		/>

		<!-- Icons -->
		<link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
		<link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
		<meta name="theme-color" content="#050505" />
		<meta name="generator" content={Astro.generator} />
		<meta name="application-name" content={site.name} />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content={site.name} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content={site.language.replace("-", "_")} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<!-- Keywords -->
		<meta
			name="keywords"
			content="noteguard, offline notes, private notes app, encrypted notes android, markdown notes app, obsidian vault, on-device ai, local llm android, whisper offline, semantic search, note lock pin, ai note taking, privacy focused app, version history notes, task reminders notes, heymeowcat"
		/>

		<title>{title}</title>

		<!-- Structured data -->
		{
			jsonLd.map((entry) => (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(entry)}
				/>
			))
		}

		{/*
			Search Console and Bing verification. Set the token in the
			deployment environment and the tag appears; without it, nothing
			is emitted.
		*/}
		{
			import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
				<meta
					name="google-site-verification"
					content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
				/>
			)
		}
		{
			import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
				<meta
					name="msvalidate.01"
					content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION}
				/>
			)
		}

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="https://fonts.gstatic.com/s/outfit/v15/QGYvz_MVcBeNP4NJtEtq.woff2"
			crossorigin
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
		/>
	</head>
	<body class="bg-ink text-white antialiased font-display">
		{
			!hideNav && (
				<header class="sticky top-0 z-50 border-b border-white/5 bg-ink/80 backdrop-blur-xl">
					<nav
						class="container mx-auto px-6 h-16 flex items-center justify-between"
						aria-label="Main"
					>
						<a href={home()} class="flex items-center gap-2.5 shrink-0">
							<img
								src={url("/logo.png")}
								alt="NoteGuard"
								width="28"
								height="24"
								class="w-7 h-auto rounded-md"
							/>
							<span class="font-bold tracking-tight text-white">NoteGuard</span>
						</a>

						<ul class="hidden md:flex items-center gap-7 text-sm text-zinc-400">
							<li>
								<a
									href={isHome ? "#features" : home("features")}
									class="hover:text-white transition-colors">Features</a
								>
							</li>
							<li>
								<a
									href={isHome ? "#security" : home("security")}
									class="hover:text-white transition-colors">Security</a
								>
							</li>
							<li>
								<a
									href={isHome ? "#ai" : home("ai")}
									class="hover:text-white transition-colors">On-device AI</a
								>
							</li>
							<li>
								<a
									href={isHome ? "#android" : home("android")}
									class="hover:text-white transition-colors">Android</a
								>
							</li>
							<li>
								<a
									href={url("/release-notes")}
									class="hover:text-white transition-colors">Release notes</a
								>
							</li>
						</ul>

						<a
							href={site.playUrl}
							target="_blank"
							rel="noopener"
							class="text-sm font-semibold bg-white text-black rounded-full px-4 py-2 hover:bg-purple-200 transition-colors"
						>
							Get the app
						</a>
					</nav>
				</header>
			)
		}
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--font-outfit: "Outfit", sans-serif;
	}
	html {
		font-family: var(--font-outfit);
	}
</style>
