---
import { site, url, home } from "../lib/site";

const currentYear = new Date().getFullYear();
const isHome = Astro.url.pathname.replace(/\/$/, "") === url("").replace(/\/$/, "");
---

<footer class="bg-ink-2 border-t border-white/8 pt-20 pb-10">
	<div class="container mx-auto px-6">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
			<div class="col-span-1 md:col-span-2">
				<div class="flex items-center gap-3 mb-6">
					<img
						src={url("/logo.png")}
						alt="NoteGuard"
						width="32"
						height="28"
						class="w-8 h-auto rounded-lg"
					/>
					<span class="text-2xl font-bold text-white tracking-tight"
						>NoteGuard</span
					>
				</div>
				<p class="text-zinc-400 text-lg leading-relaxed max-w-sm">
					An offline notes app for Android. Your notes are plain
					Markdown files on your own device, the private ones are
					encrypted with the key you type, and the AI runs on the
					phone. No account, no cloud, no tracking.
				</p>
			</div>

			<div>
				<h3 class="text-white font-bold mb-6">Product</h3>
				<ul class="space-y-4">
					<li>
						<a
							href={isHome ? "#features" : home("features")}
							class="text-zinc-400 hover:text-white transition-colors"
							>Features</a
						>
					</li>
					<li>
						<a
							href={isHome ? "#security" : home("security")}
							class="text-zinc-400 hover:text-white transition-colors"
							>Security</a
						>
					</li>
					<li>
						<a
							href={isHome ? "#ai" : home("ai")}
							class="text-zinc-400 hover:text-white transition-colors"
							>On-device AI</a
						>
					</li>
					<li>
						<a
							href={isHome ? "#android" : home("android")}
							class="text-zinc-400 hover:text-white transition-colors"
							>Android</a
						>
					</li>
					<li>
						<a
							href={url("/release-notes")}
							class="text-zinc-400 hover:text-white transition-colors"
							>Release notes</a
						>
					</li>
					<li>
						<a
							href={url("/press")}
							class="text-zinc-400 hover:text-white transition-colors"
							>Press kit</a
						>
					</li>
				</ul>
			</div>

			<div>
				<h3 class="text-white font-bold mb-6">Get it</h3>
				<ul class="space-y-4">
					<li>
						<a
							href={site.playUrl}
							target="_blank"
							rel="noopener"
							class="text-zinc-400 hover:text-white transition-colors"
							>Google Play</a
						>
					</li>
					<li>
						<a
							href={url("/privacy-policy")}
							class="text-zinc-400 hover:text-white transition-colors"
							>Privacy Policy</a
						>
					</li>
					<li>
						<a
							href={url("/terms-of-service")}
							class="text-zinc-400 hover:text-white transition-colors"
							>Terms of Service</a
						>
					</li>
				</ul>
			</div>
		</div>

		<div
			class="border-t border-white/8 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
		>
			<p class="text-[#8E8E93] text-sm">
				&copy; {currentYear} NoteGuard. All rights reserved.
			</p>
			<p class="text-[#8E8E93] text-sm">
				Android · no ads, no account, no purchases
			</p>
		</div>
	</div>
</footer>
