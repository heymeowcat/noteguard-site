---
import { site, url } from "../lib/site";
---

<section class="relative py-24 md:py-32">
	<div
		class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(168,85,247,0.20),_transparent_60%)] pointer-events-none"
	>
	</div>

	<div class="container mx-auto px-6 relative">
		<div
			class="rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.05] to-transparent p-10 md:p-16 text-center"
		>
			<img
				src={url("/logo.png")}
				alt="The NoteGuard app icon"
				width="64"
				height="55"
				class="w-16 h-auto mx-auto rounded-2xl"
			/>

			<h2
				class="mt-7 text-3xl md:text-5xl font-bold text-white tracking-tight leading-tight"
			>
				Your notes are already yours.
			</h2>
			<p class="mt-5 text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed">
				NoteGuard is free, has no ads, no account and no in-app
				purchases. It is a file on your phone that happens to be a very
				good editor.
			</p>

			<div
				class="mt-9 flex flex-col sm:flex-row gap-4 justify-center items-center"
			>
				<a
					href={site.playUrl}
					target="_blank"
					rel="noopener"
					class="group inline-flex items-center justify-center gap-3 px-8 py-4 bg-white text-black rounded-full font-bold text-lg transition-all hover:scale-[1.03] hover:shadow-[0_0_40px_rgba(168,85,247,0.35)]"
				>
					<svg
						class="w-6 h-6"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="currentColor"
						aria-hidden="true"
						><path
							d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.3,12.08L18.91,11.3L16.13,14.44L16.13,9.55L18.91,12.7L20.3,11.92C20.93,11.56 20.93,10.44 20.3,10.08L20.3,12.08M16.81,8.88L14.54,11.15L6.05,2.66L16.81,8.88Z"
						></path></svg
					>
					<span>Get NoteGuard on Google Play</span>
				</a>
				<a
					href={url("/#features")}
					class="px-8 py-4 border border-white/15 hover:border-white/30 hover:bg-white/5 rounded-full font-medium text-lg text-white transition-all"
				>
					See how it works
				</a>
			</div>

			<p class="mt-8 text-sm text-[#8E8E93]">
				Android · free · no ads, no account, no in-app purchases
			</p>
		</div>
	</div>
</section>
