---
import { site, url } from "../lib/site";
---

<section class="relative overflow-hidden pt-16 pb-24 md:pt-24 md:pb-32">
	<!-- Ambient background -->
	<div
		class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(168,85,247,0.22),_transparent_55%)] pointer-events-none"
	>
	</div>
	<div
		class="absolute inset-0 opacity-[0.04] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))]"
		style={`background-image: url('${url("/grid.svg")}')`}
	>
	</div>

	<div class="container mx-auto px-6 relative z-10">
		<div class="grid lg:grid-cols-[1.05fr_1fr] gap-14 lg:gap-16 items-center">
			<!-- Copy -->
			<div>
				<p
					class="inline-flex items-center gap-2.5 rounded-full border border-purple-400/30 bg-purple-500/10 px-4 py-1.5 text-sm font-medium text-purple-300"
				>
					<span
						class="inline-block h-1.5 w-1.5 rounded-full bg-purple-400"
					></span>
					Private by design · no account · no ads · no tracking
				</p>

				<h1
					class="mt-7 text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[0.95]"
				>
					Your notes are files.<br />
					<span
						class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-fuchsia-300 to-purple-400 animate-gradient-x bg-[length:200%_auto]">The key is yours.</span
					>
				</h1>

				<p
					class="mt-7 text-lg sm:text-xl text-zinc-400 max-w-xl leading-relaxed"
				>
					NoteGuard keeps your notes as plain Markdown files in a folder
					you choose, and locks the private ones with the PIN you type.
					Every AI model runs on your phone. There is no account, no
					server and no tracker.
				</p>

				<div
					class="mt-9 flex flex-col sm:flex-row gap-4 sm:items-center"
				>
					<a
						href={site.playUrl}
						target="_blank"
						rel="noopener"
						class="group inline-flex items-center justify-center gap-3 px-7 py-4 bg-white text-black rounded-full font-bold text-base transition-all hover:scale-[1.03] hover:shadow-[0_0_40px_rgba(168,85,247,0.35)]"
					>
						<svg
							class="w-6 h-6"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
							><path
								d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.3,12.08L18.91,11.3L16.13,14.44L16.13,9.55L18.91,12.7L20.3,11.92C20.93,11.56 20.93,10.44 20.3,10.08L20.3,12.08M16.81,8.88L14.54,11.15L6.05,2.66L16.81,8.88Z"
							></path></svg
						>
						<span>Get it on Google Play</span>
					</a>
					<a
						href={`${url("/")}#features`}
						class="inline-flex items-center justify-center px-7 py-4 border border-white/15 hover:border-white/30 hover:bg-white/5 rounded-full font-medium text-base text-white transition-all"
					>
						See how it works
					</a>
				</div>

				<!-- Trust strip -->
				<dl
					class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-5 border-t border-white/10 pt-8"
				>
					<div>
						<dt class="text-xs uppercase tracking-wider text-zinc-400">
							Encryption
						</dt>
						<dd class="mt-1.5 text-sm font-semibold text-zinc-200 whitespace-nowrap">
							AES-256 · PBKDF2
						</dd>
					</div>
					<div>
						<dt class="text-xs uppercase tracking-wider text-zinc-400">
							Accounts
						</dt>
						<dd class="mt-1.5 text-sm font-semibold text-zinc-200 whitespace-nowrap">
							None. Ever.
						</dd>
					</div>
					<div>
						<dt class="text-xs uppercase tracking-wider text-zinc-400">
							Trackers
						</dt>
						<dd class="mt-1.5 text-sm font-semibold text-zinc-200 whitespace-nowrap">
							Zero
						</dd>
					</div>
					<div>
						<dt class="text-xs uppercase tracking-wider text-zinc-400">
							Airplane mode
						</dt>
						<dd class="mt-1.5 text-sm font-semibold text-zinc-200 whitespace-nowrap">
							Works fine
						</dd>
					</div>
				</dl>
			</div>

			<!-- The vault, shown honestly -->
			<div class="relative">
				<div
					class="absolute -inset-6 bg-purple-600/20 blur-[90px] rounded-full pointer-events-none"
				>
				</div>

				<div class="relative space-y-4">
					<!-- An ordinary note -->
					<div
						class="rounded-2xl border border-white/10 bg-[#0d0d0f] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.9)] overflow-hidden"
					>
						<div
							class="flex items-center gap-2 border-b border-white/8 bg-white/[0.02] px-4 py-2.5"
						>
							<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
							<span
								class="ml-2 font-mono text-[11px] text-zinc-400 truncate"
								>Notes/Kyoto trip plan.md</span
							>
						</div>
						<pre
							class="px-5 py-4 font-mono text-[12.5px] leading-relaxed overflow-x-auto no-scrollbar"><span
								class="text-purple-300">---</span>
<span class="text-purple-300">title</span>: <span class="text-emerald-300">Kyoto trip plan</span>
<span class="text-purple-300">tags</span>: [<span class="text-emerald-300">travel</span>]
<span class="text-purple-300">---</span>

<span class="text-white">## Day one</span>
<span class="text-zinc-400">- Fushimi Inari before 8am</span>
<span class="text-zinc-400">- Arashiyama bamboo grove</span>
<span class="text-zinc-400">- matcha stand, 5pm</span>
<span class="text-sky-300">due: 2026-04-12</span> <span class="text-zinc-400">remind: 09:00</span>

<span class="text-zinc-400">$</span> <span class="text-zinc-400">cat "Notes/Kyoto trip plan.md"</span></pre
						>
					</div>

					<!-- A locked note -->
					<div
						class="rounded-2xl border border-emerald-400/20 bg-[#0d0d0f] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.9)] overflow-hidden relative"
					>
						<div
							class="flex items-center gap-2 border-b border-white/8 bg-white/[0.02] px-4 py-2.5"
						>
							<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
							<span
								class="ml-2 font-mono text-[11px] text-zinc-400 truncate"
								>Notes/Private.md</span
							>
							<span
								class="ml-auto text-[10px] font-semibold uppercase tracking-wide text-emerald-300 border border-emerald-400/30 bg-emerald-400/10 rounded-full px-2 py-0.5"
								>Locked</span
							>
						</div>
						<pre
							class="px-5 py-4 font-mono text-[12.5px] leading-relaxed overflow-x-auto no-scrollbar"><span
								class="text-zinc-400">$</span> <span class="text-zinc-400">cat "Notes/Private.md"</span>
<span class="text-emerald-300">ngAD7Qm4v0YfX2bRk9s1</span><span class="text-emerald-300/60">T8pLm3ZcQ=</span>
<span class="text-emerald-300/60">bR7wX1nJ4uK9sV0dH2yF</span><span class="text-emerald-300/60">Qa3M5tC8pL1oI6eR0wY=</span>

<span class="text-zinc-400"># AES-256-CBC + HMAC-SHA256 tag</span>
<span class="text-zinc-400"># derived from your PIN, 210,000 rounds</span>
<span class="text-zinc-400"># the PIN is stored nowhere</span></pre
						>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	@keyframes gradient-x {
		0% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
		100% {
			background-position: 0% 50%;
		}
	}
	.animate-gradient-x {
		animation: gradient-x 6s ease infinite;
	}
</style>
