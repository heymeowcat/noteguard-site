---
import Layout from "../layouts/Layout.astro";
import { site, url } from "../lib/site";

/*
 * The old address for the release notes. It is kept so that any link
 * already pointing at it still lands somewhere sensible, but it says so
 * plainly and points the crawler at the page that replaced it.
 */
---

<Layout
	title="Release notes — NoteGuard"
	description="The release notes for NoteGuard have moved to a new address."
	breadcrumbs={[{ name: "Release notes", path: "/release-notes/" }]}
	robots="noindex, follow"
	canonical={url("/release-notes/")}
	hideNav
>
	<main class="min-h-[70vh] flex items-center">
		<div class="container mx-auto px-6 max-w-2xl py-24 text-center">
			<span class="eyebrow">Moved</span>
			<h1 class="mt-4 text-4xl md:text-5xl font-bold text-white tracking-tight">
				The release notes have a new address.
			</h1>
			<p class="mt-5 text-lg text-zinc-400 leading-relaxed">
				They are now at
				<a href={url("/release-notes/")} class="text-purple-300 underline underline-offset-4"
					>/release-notes</a
				>. If you are reading this, the browser has already taken you
				there.
			</p>
			<p class="mt-10 text-sm text-zinc-600">
				NoteGuard · {site.name}
			</p>
		</div>
	</main>

	<script is:inline define:vars={{ target: url("/release-notes/") }}>
		window.location.replace(target);
	</script>
</Layout>

<meta http-equiv="refresh" content={`0; url=${url("/release-notes/")}`} />
